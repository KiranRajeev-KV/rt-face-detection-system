APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DATABASE_URL=postgresql+psycopg://face_stream:face_stream@postgres:5432/face_stream
APP_ALLOWED_ORIGIN=http://localhost:5173
APP_CORS_ORIGINS=["http://localhost:5173"]
APP_MAX_FRAME_SIZE_BYTES=1048576
APP_MAX_METADATA_SIZE_BYTES=16384
APP_MAX_IMAGE_WIDTH=1280
APP_MAX_IMAGE_HEIGHT=720
APP_DETECTOR_MIN_CONFIDENCE=0.5
APP_DETECTOR_MODEL_PATH=/app/models/blaze_face_short_range.tflite
APP_LOG_LEVEL=INFO
APP_DB_CONNECT_RETRIES=15
APP_DB_CONNECT_RETRY_DELAY_SECONDS=2
